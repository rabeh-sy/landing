  <FAQs
    id="faqs"
    title="أسئلة شائعة"
    items={[
      {
        title: 'ما هو رابح لايت؟',
        description:
          'رابح لايت هو تطبيق أعمال ومحاسبة مبسط للأعمال الصغيرة والمتوسطة، يساعدك على إدارة البيع والشراء والمخزون والعملاء والموردين والمدفوعات من الهاتف.',
      },
      {
        title: 'هل يعمل بدون إنترنت؟',
        description:
          'نعم. التطبيق مصمم بأسلوب offline-first، لذلك تبقى البيانات الأساسية محلية على الجهاز ويمكنك تنفيذ كثير من العمليات اليومية بدون اتصال.',
      },
      {
        title: 'ما الفرق بين رابح لايت ورابح بزنس؟',
        description:
          'رابح لايت مناسب للعمل المحلي على الجهاز، بينما تفتح الترقية إلى رابح بزنس مزايا إضافية مثل مزامنة النشاط بين الأجهزة وإدارة الأدوار والصلاحيات.',
      },
      {
        title: 'هل يدعم النسخ الاحتياطي؟',
        description:
          'نعم، يوفر التطبيق تصدير نسخة احتياطية من البيانات المحلية واستيرادها لاحقًا عند الحاجة.',
      },
      {
        title: 'هل توجد ميزات ذكاء اصطناعي؟',
        description:
          'نعم، يوجد مساعد ذكي يمكنه الإجابة عن أسئلة متعلقة ببيانات النشاط بعد التفعيل، ويتطلب ذلك اتصالًا بالإنترنت.',
      },
    ]}
  />

  <CallToAction
    id="download"
    title="حمّل رابح لايت على أندرويد"
    actions={[
      {
        variant: 'primary',
        text: 'تنزيل APK للأندرويد',
        href: androidApkDownloadLink,
        icon: 'tabler:download',
        download: true,
      },
    ]}
  />
</Layout>
