---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'من نحن',
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="محمد خالد بادنجكي"
    tagline="المؤسس والمدير التنفيذي"
    actions={[{ variant: 'primary', text: 'تواصل معي', href: getPermalink('/contact#form') }]}
  >
    <Fragment slot="subtitle">
      مهندس برمجيات ومؤسس شغوف ببناء حلول تقنية تُحدث فرقًا حقيقيًا. <br />
      أعمل على تطوير أنظمة برمجية موثوقة وسهلة الاستخدام، تساعد الشركات على النمو والتحول الرقمي، مع التركيز على الجودة وفهم عميق لاحتياجات السوق.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-linkedin',
        callToAction: {
          target: '_blank',
          text: 'LinkedIn',
          href: 'https://www.linkedin.com/in/m-khaled-badenjki-850860118/',
        },
      },
      {
        icon: 'tabler:brand-github',
        callToAction: {
          target: '_blank',
          text: 'Github',
          href: 'https://github.com/khaled-badenjki',
        },
      },
      {
        icon: 'tabler:brand-x',
        callToAction: {
          target: '_blank',
          text: 'X',
          href: '#',
        },
      },
    ]}
    image={{
      src: '~/assets/images/about-khaled.jpeg',
      alt: 'محمد خالد بادنجكي',
      height: 550
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">من أنا</h2>
      <p>
        أنا محمد خالد بادنجكي، مطوّر برمجيات ومؤسس شركة <strong>رابح للتقنية</strong>. أؤمن بأن التكنولوجيا قادرة على تغيير الواقع نحو الأفضل، وأسعى من خلال عملي إلى تقديم حلول برمجية عملية وفعّالة تلبي احتياجات السوق وتساهم في تطوير المجتمعات.
      </p>
      <br />
      <p>
        بدأت رحلتي المهنية بالعمل في شركات تقنية إقليمية وعالمية، حيث اكتسبت خبرة في بناء الأنظمة الموثوقة، تحسين الأداء، وتصميم بنية تحتية قادرة على التوسع. اليوم، أركز على المشاريع التي تحدث أثراً اجتماعياً حقيقياً، أعمل على تطويرها وإدارتها.
      </p>
      <br />
      <p>يمكنك متابعتي والتواصل معي عبر الروابط التالية:</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="resume"
    title="الخبرات العملية"
    items={[
      {
        title:
          'مهندس برمجيات متقدّم <br /> <span class="font-normal">قيود، الرياض، السعودية</span> <br /> <span class="text-sm font-normal">2023 - حتى الآن</span>',
        description: `تطوير وتحسين نظام المحاسبة السحابي، إضافة ميزات جديدة، تحسين الأداء، وتوجيه فريق التطوير.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'مهندس برمجيات <br /> <span class="font-normal">سويفل، القاهرة، مصر</span> <br /> <span class="text-sm font-normal">2021 - 2022</span>',
        description: `المساهمة في تطوير منصّة النقل الجماعي الذكية، والعمل على تحسين أنظمة الحجز والدفع.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'مهندس برمجيات <br /> <span class="font-normal">أولكس، القاهرة، مصر</span> <br /> <span class="text-sm font-normal">2020 - 2022</span>',
        description: `تطوير منصّة الإعلانات المبوبة وتحسين تجربة المستخدم وأداء المنظومة.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'مهندس برمجيات <br /> <span class="font-normal">روبستا ستوديو، القاهرة، مصر</span> <br /> <span class="text-sm font-normal">2018 - 2020</span>',
        description: `العمل على مشاريع برمجية لعملاء محليين ودوليين في مجالات متعددة.`,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <Steps
    id="resume"
    title="التعليم"
    items={[
      {
        title: `دراسات عليا (منحة) <br /> <span class="font-normal">جامعة ولاية أريزونا</span> <br /> <span class="text-sm font-normal">2020 - 2021</span>`,
        description: `حصلت على منحة دراسية لمتابعة الدراسات العليا في جامعة ولاية أريزونا، لكنني قررت إيقاف البرنامج لاحقًا.`,
        icon: 'tabler:school',
      },
      {
        title: `بكالوريوس علوم الحاسب والذكاء الاصطناعي <br /> <span class="font-normal">جامعة القاهرة، كلية الحاسبات والذكاء الاصطناعي</span> <br /> <span class="text-sm font-normal">2012 - 2016</span>`,
        description: `أكملت درجة البكالوريوس وتخرجت عام 2016، مع تركيز على البرمجة، هياكل البيانات، الذكاء الاصطناعي، وقواعد البيانات.`,
        icon: 'tabler:school',
      },
      {
        title: `كلية الهندسة المعلوماتية <br /> <span class="font-normal">جامعة حلب</span> <br /> <span class="text-sm font-normal">2011 - 2012</span>`,
        description: `بداية المسار الأكاديمي في سوريا ضمن تخصص الهندسة المعلوماتية قبل الانتقال إلى جامعة القاهرة.`,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />


  <!-- Features3 Widget ************** -->

  <Features3
    title="المهارات"
    subtitle="مهاراتي التقنية التي أستخدمها في بناء حلول عملية وقابلة للتوسع."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      { title: 'تطوير تطبيقات الويب', description: 'خبرة في بناء تطبيقات ويب عالية الأداء باستخدام Ruby on Rails وتقنيات حديثة.' },
      { title: 'تصميم الأنظمة', description: 'بناء أنظمة قابلة للتوسع وسهلة الصيانة.' },
      { title: 'إدارة قواعد البيانات', description: 'خبرة في PostgreSQL و Redis.' },
      { title: 'التكامل مع الخدمات الخارجية', description: 'ربط التطبيقات بواجهات برمجية خارجية (APIs) وتحقيق أتمتة متكاملة.' },
      { title: 'إدارة النشر', description: 'إعداد وإدارة بيئات الإنتاج باستخدام أدوات مثل Kamal وDocker.' },
      { title: 'تحليل الاحتياجات', description: 'فهم احتياجات العملاء وتحويلها إلى حلول تقنية عملية.' },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    id="porfolio"
    title="مشاريعي"
    subtitle="يوجد العديد من المشاريع قيد الإنشاء، ولكن هذه قائمة بالمشاريع الجاهزة أو التي تم إطلاقها"
    isReversed
    items={[
      {
        title: 'الوصف:',
        description:
          'منصة إلكترونية تمكّن المساجد من جمع التبرعات بسهولة عبر الإنترنت، مع لوحة تحكم لإدارة الحملات ومتابعة التبرعات بشفافية.',
      },
      {
        title: 'دوري:',
        description:
          'تطوير المنصة من الصفر، تصميم البنية التحتية، برمجة الواجهة الخلفية، وإدارة النشر على الخوادم.',
      },
    ]}
    image={{
      src: '~/assets/images/mosque-donation.jpg',
      height: 360,
      alt: 'منصّة التبرع للمساجد',
    }}
    callToAction={{
      target: '_blank',
      text: 'زيارة المشروع',
      icon: 'tabler:chevron-left',
      href: 'https://masajid.rabeh.sy',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        المشروع الأول: <br /><span class="text-2xl">منصّة التبرع للمساجد</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="فلنبنِ معاً"
    subtitle="إذا كانت لديك فكرة مشروع أو حل ترغب في تحويله إلى واقع، يسعدني التعاون معك."
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معي',
        href: getPermalink('/contact#form'),
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="مقالاتي"
    information={`أشارك في مدونتي مقالات تقنية وخبرات عملية في تطوير البرمجيات وريادة الأعمال، بالإضافة إلى أفكار لبناء حلول تقنية تخدم المجتمع.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
