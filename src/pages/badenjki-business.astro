    .module-card .module-icon { background: #e2f3e7; color: #168342; }
    .module-card.tone-amber .module-icon { background: #fff0d4; color: #a76d10; }
    .module-card.tone-blue .module-icon { background: #e3eefb; color: #3977b8; }
    .module-card.tone-violet .module-icon { background: #eee8fb; color: #7958b4; }
