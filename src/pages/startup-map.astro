---
import Layout from '~/layouts/PageLayout.astro';
import startups from '~/data/startups.json';

const metadata = {
  title: 'خريطة الشركات الناشئة في سوريا',
  description: 'استكشف النظام البيئي للشركات الناشئة في سوريا',
};

// Group startups by category
const categories = [...new Set(startups.map(s => s.category))];
const categoryColors = {
  'النقل الذكي': '#10b981', // Green
  'الطعام والتوصيل': '#3b82f6', // Blue
  'التعليم': '#f59e0b', // Orange
  'الصحة': '#ef4444', // Red
  'التجارة الإلكترونية': '#8b5cf6', // Purple
  'أخرى': '#6b7280' // Gray
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-20">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-4 text-gray-900 dark:text-white">
          خريطة الشركات الناشئة في سوريا
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
          استكشف النظام البيئي للشركات الناشئة السورية والابتكارات التقنية
        </p>
      </div>

      <!-- Category Legend -->
      <div class="mb-8 flex flex-wrap justify-center gap-4">
        {categories.map(category => (
          <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-slate-800 rounded-lg shadow-sm">
            <div 
              class="w-4 h-4 rounded-full" 
              style={`background-color: ${categoryColors[category] || categoryColors['أخرى']}`}
            />
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{category}</span>
          </div>
        ))}
      </div>

      <!-- Bubble Map Container -->
      <div class="bg-gradient-to-br from-amber-50 to-green-50 dark:from-slate-900 dark:to-emerald-950 rounded-2xl p-8 md:p-12 shadow-xl min-h-[600px] relative overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-5">
          <svg width="100%" height="100%">
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <circle cx="20" cy="20" r="1" fill="currentColor" />
            </pattern>
            <rect width="100%" height="100%" fill="url(#grid)" />
          </svg>
        </div>

        <!-- Bubbles Container -->
        <div id="bubble-container" class="relative z-10 flex flex-wrap justify-center items-center gap-6 min-h-[500px]">
          {startups.map((startup, index) => {
            const sizeClasses = {
              small: 'w-32 h-32 text-sm',
              medium: 'w-40 h-40 text-base',
              large: 'w-48 h-48 text-lg'
            };
            const size = startup.size || 'medium';
            const color = categoryColors[startup.category] || categoryColors['أخرى'];
            
            return (
              <div 
                class={`bubble-item ${sizeClasses[size]} flex flex-col items-center justify-center rounded-full cursor-pointer transition-all duration-300 hover:scale-110 hover:shadow-2xl group relative`}
                style={`background: linear-gradient(135deg, ${color}dd, ${color}aa); animation: float ${3 + index}s ease-in-out infinite;`}
                data-startup={JSON.stringify(startup)}
              >
                <div class="mb-2 transform group-hover:scale-110 transition-transform">
                  <img 
                    src={startup.logo} 
                    alt={`${startup.name} logo`}
                    class="w-16 h-16 object-contain rounded-lg bg-white/90 p-2"
                    loading="lazy"
                  />
                </div>
                <div class="text-white font-bold text-center px-2">
                  {startup.name}
                </div>
                <div class="text-white/80 text-xs mt-1 text-center px-2">
                  {startup.category}
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Startup Details Modal -->
      <div id="startup-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" style="direction: rtl;">
        <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-2xl w-full p-8 shadow-2xl transform transition-all">
          <div class="flex justify-between items-start mb-6">
            <div class="flex items-center gap-4">
              <div class="w-20 h-20 bg-gray-100 dark:bg-gray-700 rounded-xl flex items-center justify-center p-2">
                <img id="modal-logo" src="" alt="Startup logo" class="w-full h-full object-contain" />
              </div>
              <div>
                <h3 id="modal-title" class="text-2xl font-bold text-gray-900 dark:text-white"></h3>
                <p id="modal-category" class="text-gray-600 dark:text-gray-400"></p>
              </div>
            </div>
            <button 
              id="close-modal" 
              class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 text-2xl leading-none"
            >
              ×
            </button>
          </div>
          
          <p id="modal-description" class="text-gray-700 dark:text-gray-300 mb-6 text-lg"></p>
          
          <a 
            id="modal-link" 
            href="#" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-600 to-green-700 hover:from-emerald-700 hover:to-green-800 text-white px-6 py-3 rounded-lg font-medium transition-all hover:shadow-lg"
          >
            زيارة الموقع
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Stats Section -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 text-center shadow-lg">
          <div class="text-4xl font-bold text-emerald-600 dark:text-emerald-400 mb-2">
            {startups.length}
          </div>
          <div class="text-gray-600 dark:text-gray-400 font-medium">
            شركة ناشئة
          </div>
        </div>
        
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 text-center shadow-lg">
          <div class="text-4xl font-bold text-green-600 dark:text-green-400 mb-2">
            {categories.length}
          </div>
          <div class="text-gray-600 dark:text-gray-400 font-medium">
            قطاع
          </div>
        </div>
        
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 text-center shadow-lg">
          <div class="text-4xl font-bold text-amber-600 dark:text-amber-400 mb-2">
            🚀
          </div>
          <div class="text-gray-600 dark:text-gray-400 font-medium">
            نظام بيئي متنامي
          </div>
        </div>
      </div>

      <!-- Call to Action -->
      <div class="mt-12 bg-gradient-to-r from-emerald-600 to-green-700 dark:from-emerald-700 dark:to-green-800 rounded-2xl p-8 text-center shadow-xl">
        <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">
          هل لديك شركة ناشئة سورية؟
        </h3>
        <p class="text-emerald-100 text-lg mb-6 max-w-2xl mx-auto">
          نود إضافة شركتك إلى الخريطة. تواصل معنا لنضيفها ونساهم في دعم النظام البيئي للابتكار في سوريا
        </p>
        <a 
          href="/contact" 
          class="inline-block bg-white text-emerald-700 px-8 py-3 rounded-lg font-bold hover:bg-emerald-50 transition-colors shadow-lg hover:shadow-xl"
        >
          اتصل بنا
        </a>
      </div>
    </div>
  </section>

  <style>
    @keyframes float {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    .bubble-item {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .bubble-item:hover {
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    #startup-modal {
      backdrop-filter: blur(8px);
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // Modal functionality
      const modal = document.getElementById('startup-modal');
      const closeModal = document.getElementById('close-modal');
      const bubbles = document.querySelectorAll('.bubble-item');

      bubbles.forEach(bubble => {
        bubble.addEventListener('click', () => {
          const startup = JSON.parse(bubble.getAttribute('data-startup'));
          
          document.getElementById('modal-logo').src = startup.logo;
          document.getElementById('modal-logo').alt = startup.name + ' logo';
          document.getElementById('modal-title').textContent = startup.name;
          document.getElementById('modal-category').textContent = startup.category;
          document.getElementById('modal-description').textContent = startup.description;
          document.getElementById('modal-link').setAttribute('href', startup.link);
          
          modal.classList.remove('hidden');
        });
      });

      closeModal.addEventListener('click', () => {
        modal.classList.add('hidden');
      });

      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });

      // Escape key to close modal
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          modal.classList.add('hidden');
        }
      });
    });
  </script>
</Layout>

