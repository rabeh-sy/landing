---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import favicon from '~/assets/favicons/favicon.png';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'رابح للتقنية | شركة تقدم خدمات البرمجة - سوريا، حلب',
  ignoreTitleTemplate: true,
};

const rabehLitePermalink = getPermalink('/rabeh-lite');
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'الاستشارة مجانية - تواصل معنا',
        href: 'https://wa.me/+963954183399?text=%D8%A7%D9%84%D8%B3%D9%84%D8%A7%D9%85%20%D8%B9%D9%84%D9%8A%D9%83%D9%85%D8%8C%20%D8%A3%D9%88%D8%AF%20%D9%85%D8%B9%D8%B1%D9%81%D8%A9%20%D8%A7%D9%84%D9%85%D8%B2%D9%8A%D8%AF%20%D8%B9%D9%86%20%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC%D9%83%D9%85',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
    image={{ src: '~/assets/images/hero-image-2.png', alt: 'صورة رابح للتقنية' }}
  >
    <Fragment slot="title">
      شركة رابح للتقنية والخدمات البرمجية
    </Fragment>

    <Fragment slot="subtitle">
      خدمة برمجة عالية الجودة مع فريق متخصص يحوّل أفكارك إلى واقع
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="خدمات شركة رابح"
    items={[
      {
        title: 'انشاء مواقع على الويب',
        image: { src: favicon.src, alt: 'رابح للتقنية' },
      },
      {
        title: 'انشاء تطبيقات موبايل',
        image: { src: favicon.src, alt: 'رابح للتقنية' },
      },
      {
        title: 'انشاء متاجر الكترونية',
        image: { src: favicon.src, alt: 'رابح للتقنية' },
      },
      {
        title: 'انشاء منصات الكترونية',
        image: { src: favicon.src, alt: 'رابح للتقنية' },
      },
      {
        title: 'انشاء برامج حلول ادارية',
        image: { src: favicon.src, alt: 'رابح للتقنية' },
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    title="ميزات شركة رابح"
    items={[
      {
        title: 'الشباب أصحاب الأفكار',
        description: 'حوّل فكرتك إلى واقع عبر تطبيق على الموبايل او موقع على الويب.',
      },
      {
        title: 'للصناعيين و التجار و أصحاب المشاريع الخدمية',
        description: 'احصل على نظام متكامل يمكنك من التعريف عن عملك و التسويق له و إدارة مشروعك.',
      },
      {
        title: 'للهيئات العامة و الخاصة',
        description: 'تميزوا في العالم الرقمي مع رابح بإنشاء منصة إلكترونية.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1696861270495-7f35c35c3273?ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&q=80&w=2340',
      alt: 'Blueprint Image',
    }}
  >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-amber-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- In Progress Products ********* -->

  <Features2
    title="مشاريع قيد التنفيذ من رابح"
    subtitle="نعمل على منتجات تخدم السوق باحتياجات عملية. رابح لايت أصبح له الآن صفحة تعريفية مستقلة يمكنك تصفحها مباشرة."
    columns={2}
    classes={{
      items: {
        panel:
          'rounded-lg border border-slate-200 bg-white p-6 shadow-sm dark:border-emerald-900 dark:bg-emerald-950',
        icon: 'w-12 h-12 mb-6 text-primary dark:text-emerald-200',
      },
    }}
    items={[
      {
        title: 'رابح لايت',
        description:
          'تطبيق محاسبة وإدارة أعمال للأعمال الصغيرة يعمل من الجوال، مع متابعة للمبيعات والمشتريات والمخزون والعملاء وصفحة مستقلة توضّح المزايا وطريقة البدء.',
        icon: 'tabler:device-mobile',
        callToAction: {
          variant: 'primary',
          text: 'عرض صفحة رابح لايت',
          href: rabehLitePermalink,
          icon: 'tabler:arrow-left',
        },
      },
      {
        title: 'قريباً.. عقار',
        description: 'تطبيق احترافي للخدمات العقارية في سوريا.',
        icon: 'tabler:building-estate',
      },
    ]}
  />

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="تعرّف على المزيد في مدونتنا"
    information={`نكتب مقالات تتعلق بالتقنيّة وريادة الأعمال والتحول الرقمي والسوق السوري.
                `}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-amber-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'الاستشارة مجانية - تواصل معنا',
        href: 'https://wa.me/+963954183399?text=%D8%A7%D9%84%D8%B3%D9%84%D8%A7%D9%85%20%D8%B9%D9%84%D9%8A%D9%83%D9%85%D8%8C%20%D8%A3%D9%88%D8%AF%20%D9%85%D8%B9%D8%B1%D9%81%D8%A9%20%D8%A7%D9%84%D9%85%D8%B2%D9%8A%D8%AF%20%D8%B9%D9%86%20%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC%D9%83%D9%85',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">
    اربط حزام الأمان و<br class="block sm:hidden" />
    <span class="sm:whitespace-nowrap">استعد للمستقبل الرقمي</span>
    </Fragment>

    <Fragment slot="subtitle">
      كن مستعدًا للمستقبل وابدأ معنا 😊
    </Fragment>
  </CallToAction>
</Layout>
