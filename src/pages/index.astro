---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'رابح للتقنية — التحوّل الرقمي في سوريا. أهلاً بك في المستقبل',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'حاكينا واتس',
        href: 'https://wa.me/+963954183399?text=%D8%A7%D9%84%D8%B3%D9%84%D8%A7%D9%85%20%D8%B9%D9%84%D9%8A%D9%83%D9%85%D8%8C%20%D8%A3%D9%88%D8%AF%20%D9%85%D8%B9%D8%B1%D9%81%D8%A9%20%D8%A7%D9%84%D9%85%D8%B2%D9%8A%D8%AF%20%D8%B9%D9%86%20%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC%D9%83%D9%85',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      { text: 'أود معرفة المزيد', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image-2.png', alt: 'صورة رابح للتقنية' }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">شركة رابح للتقنية والخدمات البرمجية</span>
    </Fragment>

    split this into three lines
    <Fragment slot="subtitle">
      الإنترنت والمتاجر الإلكترونية أصبحا أمراً أساسياً في عالم الأعمال والتجارة اليوم. لا تترد وتتأخر عن السوق
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="خدمات شركة رابح"
    subtitle="عرّف عن عملك وعن شركتك وبيع منتجك عبر الإنترنت : احصل على نظام متكامل لإدارة مشروعك، وحوّل فكرتك إلى واقع عبر تطبيق على الموبايل أو موقع على الإنترنت والمزيد من الخدمات البرمجية. لا تتردد في التواصل معنا، الاستشارة مجانية"
    items={[
      {
        title: 'إنشاء مواقع على الانترنت',
        description:
          'أنشئ موقعك على الانترنت، وقدّم خدماتك أو تجارتك أو صناعتك. انقل عملك إلى مستوى آخر وسهّل عملية وصول العملاء الداخليين والخارجيين إليك',
        icon: 'tabler:world-www',
      },
      {
        title: 'أنظمة لإدارة المؤسسات والمشاريع',
        description:
          'إنشاء نظام متكامل لإدارة مشروعك، سواء كان مصنع أو فندق أو مطعم أو جمعية خيرية أو محل تجاري أو صيدلية أو أماكن ترفيهية أو أي مشروع آخر',
        icon: 'tabler:building-factory',
      },
      {
        title: 'تطبيقات موبايل حسب الطلب',
        description:
          'حول فكرتك إلى مشروع حقيقي بتطبيق على الموبايل وابدأ العمل',
        icon: 'tabler:device-mobile-code',
      },
      {
        title: 'متجر إلكتروني',
        description:
          'ابدأ الآن بيع بضاعتك. أنشى معرضك الخاص واعرض البضاعة بتفاصيلها وسهل وصول الزبائن واستلام الطلبات واتمام عملية البيع',
        icon: 'tabler:shopping-cart',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    title="ميزات شركة رابح"
    items={[
      {
        title: 'أسعار مناسبة',
        description: `نحن لا نسعى أن نكون الأرخص في السوق، ولكنّنا نوظف الحل المناسب في المكان المناسب، وقد يؤدي ذلك لتقديم أسعار تنافسيّة.`,
      },
      {
        title: 'شفافيّة في التعامل',
        description:
          'لا نورّط عملاءنا فقط لنحقّق أهدافنا في المبيعات، بل نفهم متطلبات العميل ونقدّم النصح بكل شفافية، فالعلاقة الطيّبة أهم عندنا من الكسب السريع.',
      },
      {
        title: 'استشارة مجانيّة',
        description:
          'يسعدنا أن نتواصل معك ونتعرّف عليك، تواصل معنا وسنكون سعداء لتقديم استشارة مجانيّة .',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint Image',
    }}
  >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-amber-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    isReversed
    title="ابدأ الآن وسنعمل سويّة لتحويل طموحك إلى واقع"
    items={[
      {
        title: '١: <span class="font-medium">احجز استشارة مجانية</span>',
        description:
          "نتعرّف فيها عليك ونتناقش في المشكلة التي تود حلّها وما هي الموارد المتاحة لديك.",
        icon: 'tabler:calendar-search',
      },
      {
        title: '٢: <span class="font-medium">تقديم اقتراح ومخطط</span>',
        description:
          "في حال القبول المبدأي، نقوم بإعداد مخطّط لتقديم حل مرفقاً بالتسعيرة.",
        icon: 'tabler:settings-cog',
      },
      {
        title: '٣: <span class="font-medium">عملية البناء والتطوير</span>',
        description:
          'في هذه المرحلة تبدأ بالتنفيذ، ابتداءً بالتصاميم وانتهاء بتسليم البرنامج.',
        icon: 'tabler:school',
      },
      {
        title: 'ستكون جاهز للانطلاق!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="تعرّف على المزيد في مدونتنا"
    information={`نكتب مقالات تتعلق بالتقنيّة وريادة الأعمال والتحول الرقمي والسوق السوري.
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="أسئلة متكررة"
    subtitle="تعرف على بعض التساؤلات المتكرّرة."
    tagline="لديك أسئلة؟"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'ما معنى السحابة؟',
        description:
          "أنت الآن تتصفح السحابة. هي طريقة تفاعل مع البرامج عن طريق الانترنت، بخلاف الطرق الأخري مثل تنزيل البرامج على الجها. مباشرةً.",
      },
      {
        title: 'هل أحتاج تمويل لبناء منتج رقمي؟',
        description:
          'نعم - في معظم الأحيان تحتاج إلى مموّل كي تستطيع بناء عمل في مجال التقنية أو ريادة الأعمال - وإن كانت المبالغ يمكن أن تكون مناسبة أو مساوية لبدء أي مشروع آخر.',
      },
      {
        title: 'ما هو التحوّل الرقمي؟',
        description:
          "في بعض الدول يمكنك استخراج شهادة ميلاد أو هوية شخصية دون أن تذهب لأي مكان. هذا مثال عن التحول الرقمي، الذي هو باختصار تحويل العمليات من أساليب تقليدية لأساليب الكترونية بغايةً تسهيلها ورفع كفاءتها.",
      }
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'حاكينا واتس',
        href: 'https://wa.me/+963954183399?text=%D8%A7%D9%84%D8%B3%D9%84%D8%A7%D9%85%20%D8%B9%D9%84%D9%8A%D9%83%D9%85%D8%8C%20%D8%A3%D9%88%D8%AF%20%D9%85%D8%B9%D8%B1%D9%81%D8%A9%20%D8%A7%D9%84%D9%85%D8%B2%D9%8A%D8%AF%20%D8%B9%D9%86%20%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC%D9%83%D9%85',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">
    اربط حزام الأمان و<br class="block sm:hidden" />
    <span class="sm:whitespace-nowrap">استعد للمستقبل الرقمي</span>
    </Fragment>

    <Fragment slot="subtitle">
      كن مستعدًا للمستقبل وابدأ معنا 😊
    </Fragment>
  </CallToAction>
</Layout>
