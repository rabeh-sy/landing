---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'رابح للتقنية — التحوّل الرقمي في سوريا. أهلاً بك في المستقبل',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'يالله نتكلّم',
        href: 'https://wa.me/+963954183399?text=%D8%A7%D9%84%D8%B3%D9%84%D8%A7%D9%85%20%D8%B9%D9%84%D9%8A%D9%83%D9%85%D8%8C%20%D8%A3%D9%88%D8%AF%20%D9%85%D8%B9%D8%B1%D9%81%D8%A9%20%D8%A7%D9%84%D9%85%D8%B2%D9%8A%D8%AF%20%D8%B9%D9%86%20%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC%D9%83%D9%85',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      { text: 'أود معرفة المزيد', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'صورة رابح للتقنية' }}
  >
    <Fragment slot="title">
      أهلا بك في   <span class="text-accent dark:text-white">عالم التحوّل الرقمي،</span>
      عالم رابح
    </Fragment>

    <Fragment slot="subtitle">
      سواءً كنت رائد أعمال طَموح تريد تغيير الواقع، أو صاحب عمل تريد تحسين عملك عن طريق التقنية، أو لديك شغف بالتقنيّة وتريد استخدام منتجاتنا، فنحن نرحب بك ويسرنا التعامل معك.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="التحول الرقمي:" description="عملية دمج التقنيات الرقمية في بعض أو كل جوانب العمل، مما يؤدي إلى تغيير جذري في طريقة عمل المؤسسات (للأفضل)" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="المميزات"
    title="ما الذي يجعلني أتعامل مع شركة رابح؟"
    subtitle="نجمع بين الخبرة العالية والمرونة في التعامل، الصدق والشفافية، الجودة العالية والأسعار المنافسة، فهل تستطيع ألا تتعامل معنا؟ 😊"
    items={[
      {
        title: 'أسعار منافسة',
        description:
          'لا نعيد اختراع العجلة، بل نحاول توظيف الحلول في أماكنها، وبالتالي التوفير على عملاءنا.',
        icon: 'tabler:report-money',
      },
      {
        title: 'جودة عالية',
        description:
          'نقدّم خدماتنا وفق أفضل المعايير العالميّة في جودة المنتجات الرقمية.',
        icon: 'tabler:file-invoice',
      },
      {
        title: 'شفافيّة',
        description:
          'لا نجامل عملاءنا عند مناقشة أفكارهم وحلولهم، فالكثير من الأفكار قد تكون غير واقعيّة أو مستحيلة.',
        icon: 'tabler:packages',
      },
      {
        title: 'خبرة في الحلول السحابيّة',
        description:
          'يتجه العالم لاستخدام المخدّمات (السحابة) عند الحاجة. نحن نتبنى ذلك ولدينا خبرة في التعامل معها.',
        icon: 'tabler:cloud-computing',
      },
      {
        title: 'لغتنا الأم',
        description:
          "كوننا عرب فإننا نأخذ اللغة العربية على محمل الجد عند بناء المنتجات، ونتجنب التعريب السطحي.",
        icon: 'tabler:message-language',
      },
      {
        title: 'أمن المعلومات',
        description:
          'ليس شيء جانبي أو رفاهية، بل قرارات تؤخذ وتنفّذ من اليوم الأول عندنا.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="لروّاد الأعمال"
    title="نضع بين يديكم خبراتنا لتحويل طموحاتكم إلى واقع"
    items={[
      {
        title: 'فهم للسوق المحلّي',
        description:
          'نحن نفهم السوق السوري ومافيه من تفاصيل، ونأخذ ذلك بعين الاعتبار عند بناء منتجاتنا.',
      },
      {
        title: 'اطّلاع على العالم الخارجي',
        description:
          'فهمنا للسوق المحلي ليس انغلاقاً، بل نراقب بعين آخر تطورات التقنية العالميّة، وبعين أخرى الواقع ونستلهم الأفكار ونتعلم لنرتقي بالواقع المحلّي.',
      },
      {
        title: 'مرونة عالية',
        description:
          'من أكثر ما يميّز الشركات الناشئة المرونة والقدرة على التأقلم السريع. نأخذ ذلك بعين الاعتبار عن بناء المنتجات.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">الفكرة الطموحة تحتاج إلى تنفيذ دقيق ومرن</h3>
      وهذا ما نقدمه لكم، ابتداءً من جمع المتطلبات، إلى التصميم والبناء والتسليم.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-amber-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'أسعار مناسبة',
        description: `نحن لا نسعى أن نكون الأرخص في السوق، ولكنّنا نوظف الحل المناسب في المكان المناسب، وقد يؤدي ذلك لتقديم أسعار تنافسيّة.`,
      },
      {
        title: 'شفافيّة في التعامل',
        description:
          'لا نورّط عملاءنا فقط لنحقّق أهدافنا في المبيعات، بل نفهم متطلبات العميل ونقدّم النصح بكل شفافية، فالعلاقة الطيّبة أهم عندنا من الكسب السريع.',
      },
      {
        title: 'التخطيط أولاً',
        description:
          "من الأخطاء الشائعة في ريادة الأعمال هو بناء المنتج مباشرةً. نحن نخطّط أولاً ونحاول تقديم حلول بديلة للتأكد من فعالية الفكرة، قبل أن ننفذ المشروع",
      },
      {
        title: 'استشارة مجانيّة',
        description:
          'يسعدنا أن نتواصل معك ونتعرّف عليك، تواصل معنا وسنكون سعداء لتقديم استشارة مجانيّة .',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint Image',
    }}
  >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-amber-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    isReversed
    title="ابدأ الآن وسنعمل سويّة لتحويل طموحك إلى واقع"
    items={[
      {
        title: '١: <span class="font-medium">احجز استشارة مجانية</span>',
        description:
          "نتعرّف فيها عليك ونتناقش في المشكلة التي تود حلّها وما هي الموارد المتاحة لديك.",
        icon: 'tabler:calendar-search',
      },
      {
        title: '٢: <span class="font-medium">تقديم اقتراح ومخطط</span>',
        description:
          "في حال القبول المبدأي، نقوم بإعداد مخطّط لتقديم حل مرفقاً بالتسعيرة.",
        icon: 'tabler:settings-cog',
      },
      {
        title: '٣: <span class="font-medium">عملية البناء والتطوير</span>',
        description:
          'في هذه المرحلة تبدأ بالتنفيذ، ابتداءً بالتصاميم وانتهاء بتسليم البرنامج.',
        icon: 'tabler:school',
      },
      {
        title: 'ستكون جاهز للانطلاق!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="تعرّف على المزيد في مدونتنا"
    information={`نكتب مقالات تتعلق بالتقنيّة وريادة الأعمال والتحول الرقمي والسوق السوري.
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="أسئلة متكررة"
    subtitle="تعرف على بعض التساؤلات المتكرّرة."
    tagline="لديك أسئلة؟"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'ما معنى السحابة؟',
        description:
          "أنت الآن تتصفح السحابة. هي طريقة تفاعل مع البرامج عن طريق الانترنت، بخلاف الطرق الأخري مثل تنزيل البرامج على الجها. مباشرةً.",
      },
      {
        title: 'هل أحتاج تمويل لبناء منتج رقمي؟',
        description:
          'نعم - في معظم الأحيان تحتاج إلى مموّل كي تستطيع بناء عمل في مجال التقنية أو ريادة الأعمال - وإن كانت المبالغ يمكن أن تكون مناسبة أو مساوية لبدء أي مشروع آخر.',
      },
      {
        title: 'ما هو التحوّل الرقمي؟',
        description:
          "في بعض الدول يمكنك استخراج شهادة ميلاد أو هوية شخصية دون أن تذهب لأي مكان. هذا مثال عن التحول الرقمي، الذي هو باختصار تحويل العمليات من أساليب تقليدية لأساليب الكترونية بغايةً تسهيلها ورفع كفاءتها.",
      },
      {
        title: "هل رابح شركة مرخّصة؟",
        description:
          "نعم، شركة رابح للتقنية هي شركة سوريّة محدودة المسؤولية، مرخّصة بتاريخ ٨ تموز ٢٠٢٥.",
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'يالله نتكلّم',
        href: 'https://wa.me/+963954183399?text=%D8%A7%D9%84%D8%B3%D9%84%D8%A7%D9%85%20%D8%B9%D9%84%D9%8A%D9%83%D9%85%D8%8C%20%D8%A3%D9%88%D8%AF%20%D9%85%D8%B9%D8%B1%D9%81%D8%A9%20%D8%A7%D9%84%D9%85%D8%B2%D9%8A%D8%AF%20%D8%B9%D9%86%20%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC%D9%83%D9%85',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">
    اربط حزام الأمان و<br class="block sm:hidden" />
    <span class="sm:whitespace-nowrap">استعد للمستقبل الرقمي</span>
    </Fragment>

    <Fragment slot="subtitle">
      كن مستعدًا للمستقبل وابدأ معنا 😊
    </Fragment>
  </CallToAction>
</Layout>
