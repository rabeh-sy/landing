---
import '@fontsource-variable/rubik';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Rubik Variable';
    --aw-font-serif: 'Rubik Variable';
    --aw-font-heading: 'Rubik Variable';

    --aw-color-primary: rgb(7 90 46);
    --aw-color-secondary: rgb(7 51 46);
    --aw-color-accent: rgb(7 100 46);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(3 6 32);

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: 'Rubik Variable';
    --aw-font-serif: 'Rubik Variable';
    --aw-font-heading: 'Rubik Variable';

    --aw-color-primary: rgb(170 150 110);
    --aw-color-secondary: rgb(185 167 120);
    --aw-color-accent: rgb(200 190 140);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(7 51 46);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
