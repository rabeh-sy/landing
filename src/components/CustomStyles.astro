---
import '@fontsource-variable/rubik';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Rubik Variable';
    --aw-font-serif: 'Rubik Variable';
    --aw-font-heading: 'Rubik Variable';

    --aw-color-primary: rgb(156 255 126);
    --aw-color-secondary: rgb(205 255 190);
    --aw-color-accent: rgb(156 255 126);

    --aw-color-text-heading: rgb(245 247 238);
    --aw-color-text-default: rgb(236 241 229);
    --aw-color-text-muted: rgb(236 241 229 / 68%);
    --aw-color-bg-page: rgb(10 12 10);
    --aw-color-bg-page-90: rgba(10, 12, 10, 0.92);

    --aw-color-bg-page-dark: rgb(10 12 10);

    --aw-btn-bg-secondary: rgb(25 29 25);

    ::selection {
      background-color: rgb(156 255 126);
      color: rgb(10 12 10);
    }
  }

  .dark {
    --aw-font-sans: 'Rubik Variable';
    --aw-font-serif: 'Rubik Variable';
    --aw-font-heading: 'Rubik Variable';

    --aw-color-primary: rgb(156 255 126);
    --aw-color-secondary: rgb(205 255 190);
    --aw-color-accent: rgb(156 255 126);

    --aw-color-text-heading: rgb(245 247 238);
    --aw-color-text-default: rgb(236 241 229);
    --aw-color-text-muted: rgb(236 241 229 / 68%);
    --aw-color-bg-page: rgb(10 12 10);

    --aw-color-bg-page-dark: rgb(10 12 10);


    ::selection {
      background-color: rgb(156 255 126);
      color: rgb(10 12 10);
    }
  }
</style>
