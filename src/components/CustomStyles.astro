---
import '@fontsource-variable/rubik';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Rubik Variable';
    --aw-font-serif: 'Rubik Variable';
    --aw-font-heading: 'Rubik Variable';

    --aw-color-primary: rgb(16 57 53);
    --aw-color-secondary: rgb(1 44 30);
    --aw-color-accent: rgb(32 114 50);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(230 230 220);
    --aw-color-bg-page-90: rgba(230, 230, 220, 0.9);

    --aw-color-bg-page-dark: rgb(3 6 32);

    --aw-btn-bg-secondary: rgb(220 220 210);

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: 'Rubik Variable';
    --aw-font-serif: 'Rubik Variable';
    --aw-font-heading: 'Rubik Variable';

    --aw-color-primary: rgb(16 57 53);
    --aw-color-secondary: rgb(1 44 30);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(8 28 26);

    --aw-color-bg-page-dark: rgb(8 28 26);


    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
