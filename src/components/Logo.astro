---
import { SITE } from 'astrowind:config';
import logoLight from '~/assets/images/logo-light.png';
import logoDark from '~/assets/images/logo-dark.png';
---

  <img
    src={logoLight.src}
    alt={SITE?.name}
    class="block dark:hidden h-8 w-auto"
  />
  <img
    src={logoDark.src}
    alt={SITE?.name}
    class="hidden dark:block h-8 w-auto"
  />

