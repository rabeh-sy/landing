---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { getHomePermalink } from '~/utils/permalinks';

type Link = { text?: string; href?: string; ariaLabel?: string; icon?: string };
type Links = { title?: string; links: Array<Link> };

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '' } = Astro.props;
---

<footer class="border-t border-white/10 bg-[#0a0c0a] text-[#f3f0e8]">
  <div class="mx-auto max-w-[1480px] px-5 py-12 sm:px-8 lg:px-12 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_0.5fr]">
      <div>
        <a href={getHomePermalink()} class="inline-flex"><Logo /></a>
        <p class="mt-7 max-w-lg text-base leading-8 text-white/48">استوديو برمجيات مستقل من حلب. نصمم ونبني منتجات رقمية وأنظمة أعمال واضحة وقابلة للاستمرار.</p>
        <div class="mt-6 flex flex-wrap items-center gap-2" aria-label="تحميل بادنجكي الإداري">
          <span class="ml-2 text-xs font-bold text-white/50">بادنجكي الإداري</span>
          <button type="button" data-download-platform="ios" class="border border-white/20 px-3 py-2 text-xs font-bold hover:border-[#9cff7e]">iOS</button>
          <button type="button" data-download-platform="android" class="border border-white/20 px-3 py-2 text-xs font-bold hover:border-[#9cff7e]">Android</button>
          <button type="button" data-download-platform="windows" class="border border-white/20 px-3 py-2 text-xs font-bold hover:border-[#9cff7e]">Windows</button>
        </div>
        <p class="mt-8 text-xs font-bold tracking-wide text-white/28">س.ت 23888/2025 · حلب، سوريا</p>
      </div>

      <div class="grid grid-cols-2 gap-8">
        {links.map(({ title, links: groupLinks }) => (
          <div><p class="mb-4 text-xs font-bold text-white/30">{title}</p><ul class="space-y-3 text-sm font-bold">{groupLinks.map(({ text, href }) => <li><a href={href} class="text-white/66 transition hover:text-[#9cff7e]">{text}</a></li>)}</ul></div>
        ))}
        <div><p class="mb-4 text-xs font-bold text-white/30">تابعنا</p><div class="flex gap-2">{socialLinks.map(({ ariaLabel, href, icon }) => <a aria-label={ariaLabel} href={href} target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center border border-white/15 text-white/60 transition hover:border-[#9cff7e] hover:text-[#9cff7e]">{icon && <Icon name={icon} class="h-4 w-4" />}</a>)}</div></div>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-5 border-t border-white/10 pt-7 text-xs text-white/32 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap gap-x-5 gap-y-2">{secondaryLinks.map(({ text, href }) => <a href={href} class="transition hover:text-white"><Fragment set:html={text} /></a>)}</div>
      <div><Fragment set:html={footNote} /></div>
    </div>
  </div>
</footer>
