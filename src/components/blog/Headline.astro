---
const { title = await Astro.slots.render('default'), subtitle = await Astro.slots.render('subtitle') } = Astro.props;
---

<header class="mb-14 border-b border-[#111511] pb-10 text-right md:mb-20 md:pb-14">
  <p class="mb-6 text-xs font-bold tracking-wide text-[#111511]/40">[ دفتر رابح ]</p>
  <h1 class="max-w-5xl text-5xl font-black leading-[1.1] tracking-[-0.05em] text-[#111511] md:text-7xl" set:html={title} />
  {
    subtitle && (
      <div class="mt-6 max-w-2xl text-lg font-medium leading-8 text-[#111511]/55" set:html={subtitle} />
    )
  }
</header>
