---
import BadenjkiHome from '../components/BadenjkiHome.astro';
import AccountDeletion from '../components/AccountDeletion.astro';
import Layout from '../layouts/Layout.astro';
import LegalLayout from '../layouts/LegalLayout.astro';
import privacyPolicy from '../content/privacy-policy.json';
import terms from '../content/terms.json';
import { languages, localizedPath, pagePaths, siteCopy, type Language, type PagePath } from '../lib/language';

export function getStaticPaths() {
  return pagePaths.flatMap((page) => [
    { params: { path: page.slice(1) || undefined }, props: { lang: 'ar', page } },
    ...languages.map((lang) => ({
      params: { path: localizedPath(lang, page).slice(1) },
      props: { lang, page },
    })),
  ]);
}

interface Props {
  lang: Language;
  page: PagePath;
}

const { lang, page } = Astro.props;
---

{
  page === '/' ? (
    <BadenjkiHome {lang} />
  ) : page === '/privacy' || page === '/terms' ? (
    <LegalLayout {lang} {page} document={(page === '/privacy' ? privacyPolicy : terms)[lang]} />
  ) : page === '/pricing' ? (
    <Layout {lang} {page} title={siteCopy[lang].pricing} analytics={false}>
      <section class="mx-auto min-h-[65vh] max-w-[1440px] px-5 py-16 sm:px-8 lg:px-12 lg:py-20">
        <h1 class="text-4xl font-black md:text-5xl">{siteCopy[lang].pricing}</h1>
      </section>
    </Layout>
  ) : (
    <AccountDeletion {lang} />
  )
}
