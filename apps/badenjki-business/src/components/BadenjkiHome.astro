---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import BadenjkiSignup from './BadenjkiSignup.astro';
import appMark from '../assets/badenjki-business-mark.png';
import { localizedPath, siteCopy, type Language } from '../lib/language';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const text = (ar: string, en: string) => (lang === 'ar' ? ar : en);
const { brand, company } = siteCopy[lang];

const modules = [
  {
    title: text('المبيعات', 'Sales'),
    description: text(
      'فواتير، مردودات، سندات تسليم، ومتابعة أرصدة الزبائن.',
      'Invoices, returns, delivery notes, and customer balances.'
    ),
    icon: 'tabler:receipt-2',
    tone: 'lime',
  },
  {
    title: text('المشتريات', 'Purchases'),
    description: text(
      'فواتير شراء، موردون، مردودات، واستحقاقات واضحة.',
      'Purchase invoices, suppliers, returns, and amounts due.'
    ),
    icon: 'tabler:shopping-bag',
    tone: 'amber',
  },
  {
    title: text('المخزون', 'Inventory'),
    description: text(
      'مواد، مستودعات، تحويلات، جرد، وتنبيهات نقص المخزون.',
      'Items, warehouses, stock transfers, stock counts, and low-stock alerts.'
    ),
    icon: 'tabler:box',
    tone: 'blue',
  },
  {
    title: text('الخزينة', 'Treasury'),
    description: text(
      'قبض ودفع، صناديق وحسابات مالية، وحركة يومية منظمة.',
      'Receipts, payments, cash registers, and financial accounts in one place.'
    ),
    icon: 'tabler:wallet',
    tone: 'violet',
  },
  {
    title: text('المحاسبة', 'Accounting'),
    description: text(
      'قيود وتقارير تساعدك على رؤية الأرقام خلف كل حركة.',
      'Journal entries and reports that show the numbers behind each transaction.'
    ),
    icon: 'tabler:calculator',
    tone: 'rose',
  },
  {
    title: text('التقارير', 'Reports'),
    description: text(
      'كشف حساب، حركة مواد، مبيعات، مشتريات، وأرصدة قابلة للطباعة.',
      'Account statements, stock movements, sales, purchases, and printable balances.'
    ),
    icon: 'tabler:chart-bar',
    tone: 'teal',
  },
];

const faqs = [
  {
    question: text(
      'هل يحتاج بادنجكي الإداري إلى اتصال دائم بالإنترنت؟',
      'Does Badenjki Business need a constant internet connection?'
    ),
    answer: text(
      'لا. صُمم التطبيق بأسلوب offline-first، لذلك تبقى بيانات العمل الأساسية على جهازك وتستمر العمليات اليومية عند ضعف الاتصال أو انقطاعه. المزامنة والمساعد الذكي فقط يحتاجان إلى اتصال عند استخدامهما.',
      'The app is built to work offline. Your core business data stays on your device so you can keep working when the connection is weak or unavailable. Sync and the AI assistant require a connection when you use them.'
    ),
  },
  {
    question: text('هل نسخة سطح المكتب تطبيق مستقل؟', 'Is the desktop version a separate app?'),
    answer: text(
      'هي واجهة سطح مكتب لبادنجكي الإداري نفسه، وتستخدم نفس منطق الأعمال والبيانات والميزات. صُممت للشاشات الكبيرة والعمل المكثف، بينما تبقى نسخة الجوال أسرع للمهام أثناء الحركة.',
      'The desktop version of Badenjki Business uses the same business rules, data, and features. It is designed for large screens and longer work sessions. The mobile version is handy for tasks on the go.'
    ),
  },
  {
    question: text('ما الأنظمة المدعومة حاليًا؟', 'Which platforms are supported?'),
    answer: text(
      'يتوفر التطبيق على Android وiPhone وiPad، إضافة إلى نسخة سطح مكتب مخصصة لنظام Windows. يمكنك تحميل كل نسخة مباشرة من رابط المنصة المناسبة.',
      'The app is available on Android, iPhone, iPad, and Windows. Use the download link for your device.'
    ),
  },
  {
    question: text('هل يمكن أخذ نسخة احتياطية من البيانات؟', 'Can I back up my data?'),
    answer: text(
      'نعم. يمكنك تصدير نسخة احتياطية من قاعدة بيانات العمل المحلية واستعادتها لاحقًا عند الحاجة.',
      'Yes. You can export a backup of your local business database and restore it when needed.'
    ),
  },
  {
    question: text('ماذا يقدم المساعد الذكي؟', 'What can the AI assistant do?'),
    answer: text(
      'يمكنك سؤاله عن الفواتير والعملاء والمواد والتقارير المتاحة ضمن صلاحياتك. هذه ميزة متصلة بالإنترنت وتُرسل فقط السياق المطلوب للإجابة.',
      'Ask about invoices, customers, items, and reports you have permission to access. The assistant needs an internet connection and sends only the context required to answer.'
    ),
  },
];

const metadata = {
  title: text(
    'بادنجكي الإداري | برنامج إدارة أعمال للجوال وسطح المكتب',
    'Badenjki Business | Business management software for mobile and desktop'
  ),
  description: text(
    'برنامج متعدد اللغات لإدارة المبيعات والمشتريات والمخزون والحسابات، متوفر على iOS وAndroid وWindows ويعمل بدون إنترنت.',
    'Multilingual, offline business software for sales, purchases, inventory, and accounting on iOS, Android, and Windows.'
  ),
};

const homepage = new URL(localizedPath(lang, '/'), Astro.site).href;
const structuredData = [
  {
    '@type': 'SoftwareApplication',
    '@id': `${homepage}#app`,
    name: brand,
    alternateName: text('Badenjki Business', 'بادنجكي الإداري'),
    url: homepage,
    description: metadata.description,
    applicationCategory: 'BusinessApplication',
    operatingSystem: ['Android', 'iOS', 'iPadOS', 'Windows'],
    inLanguage: ['ar', 'en'],
    image: new URL(appMark.src, Astro.site).toString(),
    author: { '@type': 'Organization', name: company, url: 'https://rabeh.sy/' },
    featureList: modules.map((module) => module.title),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<Layout {...metadata} {lang} page="/" structuredData={structuredData}>
  <BadenjkiSignup {lang} />
  <div class="product-page overflow-hidden bg-[#f5f6f0] text-[#102219]">
    <section class="relative isolate overflow-hidden border-b border-[#173f2b]/10 lg:min-h-[780px]">
      <div class="hero-grid absolute inset-0 -z-20"></div>
      <div class="absolute -right-32 top-20 -z-10 h-[520px] w-[520px] rounded-full bg-[#9ee6b8]/35 blur-3xl"></div>
      <div class="absolute -left-40 bottom-0 -z-10 h-[420px] w-[420px] rounded-full bg-[#f0cf69]/25 blur-3xl"></div>

      <div
        class="mx-auto grid max-w-[1440px] items-center gap-14 px-5 pb-20 pt-28 sm:px-8 lg:grid-cols-[0.88fr_1.12fr] lg:px-12 lg:pb-28 lg:pt-36"
      >
        <div class="relative z-10 max-w-2xl">
          <div
            class="mb-8 inline-flex items-center gap-3 rounded-full border border-[#173f2b]/15 bg-white/70 px-4 py-2 text-sm font-semibold shadow-sm backdrop-blur"
          >
            <span class="relative flex h-2.5 w-2.5"
              ><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#2f9c5b] opacity-50"
              ></span><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#168342]"></span></span
            >
            {text('على الجوال وسطح المكتب', 'On mobile and desktop')}
          </div>

          <div class="mb-7 flex items-center gap-4">
            <img
              src={appMark.src}
              alt={text('شعار بادنجكي الإداري', 'Badenjki Business logo')}
              class="h-14 w-14 rounded-2xl shadow-lg shadow-[#0d6d38]/20"
            />
            <div>
              <p class="text-lg font-black leading-tight">{brand}</p><p
                class="mt-1 text-xs font-bold uppercase tracking-[0.16em] text-[#4d6859]"
                lang={lang === 'ar' ? 'en' : 'ar'}
              >
                {text('Badenjki Business', 'بادنجكي الإداري')}
              </p>
            </div>
          </div>

          <h1
            class="max-w-[780px] text-[3.25rem] font-black leading-[1.4] tracking-[-0.025em] text-[#102219] sm:text-6xl sm:leading-[1.34] lg:text-[4.6rem]"
          >
            {text('شغلك مرتب.', 'Keep your business organized.')}<br />
            <span class="relative inline-block text-[#13743b]"
              >{text('أينما كنت.', 'Wherever you are.')}<svg
                class="absolute -bottom-3 start-0 h-4 w-full"
                viewBox="0 0 330 18"
                fill="none"
                aria-hidden="true"
                ><path d="M5 12.5C84 2.5 177 2 325 9" stroke="#8fd5a8" stroke-width="9" stroke-linecap="round"
                ></path></svg
              ></span
            >
          </h1>

          <p class="mt-9 max-w-xl text-lg font-medium leading-9 text-[#445a4d] sm:text-xl">
            {
              text(
                'برنامج واضح ومرن لإدارة المبيعات والمشتريات والمخزون والحسابات. على الجوال للسرعة، وعلى سطح المكتب للمساحة والتركيز—وبياناتك معك حتى بدون إنترنت.',
                'Manage sales, purchases, inventory, and accounting in one flexible app. Use your phone for quick tasks and your desktop when you need more room. Your data is available offline.'
              )
            }
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-3">
            <button
              type="button"
              data-download-platform="ios"
              aria-label={text('تحميل بادنجكي الإداري من متجر أبل', 'Download Badenjki Business from the App Store')}
              class="download-badge"
              ><Icon name="tabler:brand-apple-filled" class="h-[29px] w-[29px] shrink-0" /><span
                class="text-start leading-none"
                ><small class="block text-[11px] font-medium">{text('التحميل من', 'Download on the')}</small><strong
                  class="mt-0.5 block text-[17px] font-semibold">{text('متجر أبل', 'App Store')}</strong
                ></span
              ></button
            >
            <button
              type="button"
              data-download-platform="android"
              aria-label={text('تحميل بادنجكي الإداري من متجر غوغل', 'Download Badenjki Business from Google Play')}
              class="download-badge"
              ><Icon name="tabler:brand-google-play" class="h-[29px] w-[29px] shrink-0" /><span
                class="text-start leading-none"
                ><small class="block text-[11px] font-medium">{text('التحميل من', 'Download on the')}</small><strong
                  class="mt-0.5 block text-[17px] font-semibold">{text('متجر غوغل', 'Google Play')}</strong
                ></span
              ></button
            >
            <button
              type="button"
              data-download-platform="windows"
              class="download-badge"
              aria-label={text('تحميل بادنجكي الإداري لنظام ويندوز', 'Download Badenjki Business for Windows')}
              ><Icon name="tabler:brand-windows" class="h-[29px] w-[29px] shrink-0" /><span
                class="text-start leading-none"
                ><small class="block text-[11px] font-medium">{text('التحميل لنظام', 'Download for')}</small><strong
                  class="mt-0.5 block text-[17px] font-semibold">{text('ويندوز', 'Windows')}</strong
                ></span
              ></button
            >
          </div>

          <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold text-[#567064]">
            <span class="inline-flex items-center gap-2"
              ><Icon name="tabler:wifi-off" class="h-4 w-4 text-[#168342]" />
              {text('يعمل بدون إنترنت', 'Works offline')}</span
            >
            <span class="inline-flex items-center gap-2"
              ><Icon name="tabler:language" class="h-4 w-4 text-[#168342]" />
              {text('العربية والإنجليزية', 'Arabic and English')}</span
            >
            <span class="inline-flex items-center gap-2"
              ><Icon name="tabler:database" class="h-4 w-4 text-[#168342]" /> {text('بيانات محلية', 'Local data')}</span
            >
          </div>
        </div>

        <div class="relative mx-auto hidden w-full max-w-[760px] pb-12 pt-6 lg:block lg:pb-0 lg:pt-0">
          <div
            class="desktop-frame relative overflow-hidden rounded-[26px] border-[8px] border-[#183227] bg-[#e8eee8] shadow-[0_45px_100px_-35px_rgba(13,48,30,0.55)]"
          >
            <div class="flex h-10 items-center justify-between border-b border-black/10 bg-[#f6f8f4] px-4" dir="ltr">
              <div class="flex gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-[#ff655e]"></span><span
                  class="h-2.5 w-2.5 rounded-full bg-[#ffbd44]"></span><span
                  class="h-2.5 w-2.5 rounded-full bg-[#00ca4e]"></span>
              </div>
              <span class="text-[10px] font-bold tracking-wide text-[#5d6f64]">BADENJKI BUSINESS</span><span
                class="w-10"></span>
            </div>
            <div class="grid min-h-[430px] grid-cols-[150px_1fr] bg-[#f8faf7]">
              <aside class="border-e border-[#d8e0d9] bg-[#edf2ed] p-4">
                <div class="mb-7 flex items-center gap-2">
                  <img src={appMark.src} alt="" class="h-8 w-8 rounded-lg" /><div>
                    <p class="text-[10px] font-black">{brand}</p><p class="text-[7px] text-[#718076]">
                      {text('شركة البشائر', 'Al Bashayer Co.')}
                    </p>
                  </div>
                </div>
                <div class="space-y-1.5 text-[9px] font-bold text-[#607065]">
                  <div class="flex items-center gap-2 rounded-lg bg-[#dce9df] px-2.5 py-2.5 text-[#126c38]">
                    <Icon name="tabler:layout-dashboard" class="h-3.5 w-3.5" />
                    {text('لوحة المعلومات', 'Dashboard')}
                  </div>
                  <div class="flex items-center gap-2 px-2.5 py-2">
                    <Icon name="tabler:receipt-2" class="h-3.5 w-3.5" />
                    {text('المبيعات', 'Sales')}
                  </div>
                  <div class="flex items-center gap-2 px-2.5 py-2">
                    <Icon name="tabler:shopping-bag" class="h-3.5 w-3.5" />
                    {text('المشتريات', 'Purchases')}
                  </div>
                  <div class="flex items-center gap-2 px-2.5 py-2">
                    <Icon name="tabler:box" class="h-3.5 w-3.5" />
                    {text('المخزون', 'Inventory')}
                  </div>
                  <div class="flex items-center gap-2 px-2.5 py-2">
                    <Icon name="tabler:wallet" class="h-3.5 w-3.5" />
                    {text('الخزينة', 'Treasury')}
                  </div>
                  <div class="flex items-center gap-2 px-2.5 py-2">
                    <Icon name="tabler:chart-bar" class="h-3.5 w-3.5" />
                    {text('التقارير', 'Reports')}
                  </div>
                </div>
              </aside>
              <div class="p-5">
                <div class="mb-5 flex items-center justify-between">
                  <div>
                    <p class="text-lg font-black">{text('صباح الخير 👋', 'Good morning 👋')}</p><p
                      class="mt-1 text-[9px] text-[#718076]"
                    >
                      {text('إليك ملخص أعمالك اليوم', 'Here is your business today')}
                    </p>
                  </div><button class="rounded-lg bg-[#126c38] px-3 py-2 text-[9px] font-bold text-white"
                    >{text('فاتورة جديدة +', '+ New invoice')}</button
                  >
                </div>
                <div class="grid grid-cols-3 gap-3">
                  <div class="rounded-xl border border-[#dfe6df] bg-white p-3">
                    <p class="text-[8px] text-[#718076]">{text('مبيعات اليوم', "Today's sales")}</p><p
                      class="mt-2 text-sm font-black"
                    >
                      2,480,000 <small class="text-[7px]">{text('ل.س', 'SYP')}</small>
                    </p><span
                      class="mt-2 inline-block rounded-full bg-[#e2f4e8] px-2 py-1 text-[7px] font-bold text-[#168342]"
                      >+ 12.5%</span
                    >
                  </div>
                  <div class="rounded-xl border border-[#dfe6df] bg-white p-3">
                    <p class="text-[8px] text-[#718076]">{text('المقبوضات', 'Receipts')}</p><p
                      class="mt-2 text-sm font-black"
                    >
                      1,760,000 <small class="text-[7px]">{text('ل.س', 'SYP')}</small>
                    </p><span
                      class="mt-2 inline-block rounded-full bg-[#fff0d6] px-2 py-1 text-[7px] font-bold text-[#a76d10]"
                      >{text('8 عمليات', '8 transactions')}</span
                    >
                  </div>
                  <div class="rounded-xl border border-[#dfe6df] bg-white p-3">
                    <p class="text-[8px] text-[#718076]">{text('تنبيهات المخزون', 'Stock alerts')}</p><p
                      class="mt-2 text-sm font-black"
                    >
                      6 <small class="text-[7px]">{text('مواد', 'items')}</small>
                    </p><span
                      class="mt-2 inline-block rounded-full bg-[#fee5e3] px-2 py-1 text-[7px] font-bold text-[#b54b42]"
                      >{text('تحتاج مراجعة', 'Needs review')}</span
                    >
                  </div>
                </div>
                <div class="mt-3 grid grid-cols-[1.4fr_1fr] gap-3">
                  <div class="rounded-xl border border-[#dfe6df] bg-white p-4">
                    <div class="flex items-center justify-between">
                      <p class="text-[9px] font-black">{text('حركة المبيعات', 'Sales activity')}</p><span
                        class="text-[7px] text-[#718076]">{text('آخر 7 أيام', 'Last 7 days')}</span
                      >
                    </div><div class="mt-4 flex h-28 items-end gap-2" dir="ltr">
                      {
                        [38, 58, 42, 76, 54, 88, 69].map((height, index) => (
                          <div class="flex flex-1 flex-col items-center gap-1">
                            <>
                              <div
                                class:list={['w-full rounded-t-sm', index === 5 ? 'bg-[#168342]' : 'bg-[#b9ddc5]']}
                                style={`height:${height}%`}
                              />
                              <span class="text-[6px] text-[#819086]">{index + 1}</span>
                            </>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                  <div class="rounded-xl border border-[#dfe6df] bg-white p-4">
                    <p class="text-[9px] font-black">{text('أحدث الفواتير', 'Latest invoices')}</p><div
                      class="mt-4 space-y-3"
                    >
                      {
                        [
                          [text('شركة النور', 'Al Noor Co.'), '480,000'],
                          [text('مؤسسة الهدى', 'Al Huda Trading'), '325,000'],
                          [text('متجر الشام', 'Al Sham Store'), '210,000'],
                        ].map(([name, amount], index) => (
                          <div class="flex items-center justify-between border-b border-[#edf1ed] pb-2">
                            <>
                              <div class="flex items-center gap-2">
                                <>
                                  <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-[#eef4ef] text-[7px] font-black text-[#126c38]">
                                    {index + 1}
                                  </span>
                                  <span class="text-[7px] font-bold">{name}</span>
                                </>
                              </div>
                              <span class="text-[7px] font-black">{amount}</span>
                            </>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div
            class="phone-frame absolute -bottom-2 -end-2 w-[180px] overflow-hidden rounded-[28px] border-[7px] border-[#163025] bg-[#f8faf7] shadow-[0_35px_70px_-20px_rgba(13,48,30,0.55)] sm:-end-5 sm:w-[210px]"
          >
            <div class="mx-auto mt-2 h-4 w-16 rounded-full bg-[#163025]"></div><div class="p-4 pt-3">
              <div class="mb-4 flex items-center justify-between">
                <div>
                  <p class="text-[11px] font-black">{text('مرحبًا خالد', 'Hello, Khaled')}</p><p
                    class="text-[7px] text-[#718076]"
                  >
                    {text('ملخص اليوم', "Today's summary")}
                  </p>
                </div><img src={appMark.src} alt="" class="h-7 w-7 rounded-lg" />
              </div>
              <div class="rounded-2xl bg-[#126c38] p-4 text-white">
                <p class="text-[7px] text-white/70">{text('الرصيد الإجمالي', 'Total balance')}</p><p
                  class="mt-2 text-base font-black"
                >
                  3,240,000 <small class="text-[7px]">{text('ل.س', 'SYP')}</small>
                </p>
              </div>
              <p class="mb-2 mt-4 text-[9px] font-black">{text('الوحدات', 'Modules')}</p><div
                class="grid grid-cols-2 gap-2"
              >
                {
                  [
                    ['tabler:receipt-2', text('المبيعات', 'Sales')],
                    ['tabler:shopping-bag', text('المشتريات', 'Purchases')],
                    ['tabler:box', text('المخزون', 'Inventory')],
                    ['tabler:wallet', text('الخزينة', 'Treasury')],
                  ].map(([icon, label]) => (
                    <div class="rounded-xl border border-[#e0e6e0] bg-white p-2.5">
                      <>
                        <Icon name={icon} class="h-4 w-4 text-[#168342]" />
                        <p class="mt-2 text-[7px] font-bold">{label}</p>
                      </>
                    </div>
                  ))
                }
              </div>
              <div class="mt-4 flex justify-around border-t border-[#e0e6e0] pt-3 text-[#77877d]">
                <Icon name="tabler:home" class="h-4 w-4 text-[#168342]" /><Icon
                  name="tabler:sparkles"
                  class="h-4 w-4"
                /><Icon name="tabler:user" class="h-4 w-4" />
              </div>
            </div>
          </div>
          <div
            class="device-note absolute -start-3 -top-5 flex items-center gap-2 rounded-2xl border border-white/70 bg-white/90 px-4 py-3 text-xs font-black text-[#173f2b] shadow-xl backdrop-blur sm:start-8"
          >
