{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/rabeh-lite",
      "destination": "/badenjki-business",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
